{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketops.dev/schemas/benchmark/judge-verdict.schema.json",
  "title": "MarketOps Benchmark Judge Verdict",
  "description": "One structured semantic judgement produced by the blind judge (Jev or a declared alternative). The judge never sees provider names. Every assertion must cite evidence; abstention is a first-class outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "verdict_id", "case_id", "layer", "judge",
    "blind", "dimensions", "overall", "abstained", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "marketops.benchmark.judge.v1" },
    "verdict_id": { "type": "string" },
    "case_id": { "type": "string" },
    "layer": { "enum": ["search", "fetch", "e2e"] },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "prompt_version"],
      "properties": {
        "provider": { "enum": ["jev", "deepseek", "other", "none"] },
        "model": { "type": "string" },
        "prompt_version": { "type": "string" }
      }
    },
    "blind": { "type": "boolean", "description": "True when provider identity was stripped from the payload." },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search_relevance", "source_authority", "content_completeness",
        "evidence_quality", "entity_attribution", "freshness", "final_answer_quality"
      ],
      "properties": {
        "search_relevance": { "$ref": "#/$defs/dimension" },
        "source_authority": { "$ref": "#/$defs/dimension" },
        "content_completeness": { "$ref": "#/$defs/dimension" },
        "evidence_quality": { "$ref": "#/$defs/dimension" },
        "entity_attribution": { "$ref": "#/$defs/dimension" },
        "freshness": { "$ref": "#/$defs/dimension" },
        "final_answer_quality": { "$ref": "#/$defs/dimension" }
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "confidence", "rationale"],
      "properties": {
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string" }
      }
    },
    "abstained": { "type": "boolean" },
    "abstain_reason": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "cost_usd": { "type": "number" }
      }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "confidence", "evidence", "rationale"],
      "properties": {
        "score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "null when the judge abstains on this dimension."
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["quote", "source_ref"],
            "properties": {
              "quote": { "type": "string", "maxLength": 500, "description": "Exact span from the payload; paraphrase is not evidence." },
              "source_ref": { "type": "string", "description": "URL or field path the quote came from." }
            }
          }
        },
        "rationale": { "type": "string" }
      }
    }
  }
}
