{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketops.dev/schemas/benchmark/e2e-case.schema.json",
  "title": "MarketOps End-to-End Benchmark Case",
  "description": "A complete research job: Search -> URL discovery -> Fetch -> Extraction -> Entity resolution -> Evidence -> Delivery. Scored on the delivered business result, not on intermediate API responses.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "schema_version", "split", "scenario", "market", "language",
    "brief", "target_entities", "acceptance", "budget", "gold_label",
    "label_status", "validation_timestamp", "notes"
  ],
  "properties": {
    "case_id": { "type": "string", "pattern": "^E2E-[A-Z]{2,3}-[A-Z0-9-]+-[0-9]{3}$" },
    "schema_version": { "const": "marketops.benchmark.case.v1" },
    "split": { "enum": ["development", "validation", "holdout"] },
    "scenario": {
      "enum": [
        "organisation_discovery",
        "official_website_resolution",
        "public_contact_discovery",
        "responsible_person_discovery",
        "sports_venue_discovery",
        "government_directory_extraction",
        "pdf_and_open_data_extraction",
        "social_profile_discovery",
        "cross_source_verification"
      ]
    },
    "market": { "type": "string" },
    "language": { "type": "string" },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "region", "deliverable"],
      "properties": {
        "goal": { "type": "string" },
        "region": { "type": "string" },
        "deliverable": { "type": "string" }
      }
    },
    "target_entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "name", "entity_type"],
        "properties": {
          "entity_id": { "type": "string" },
          "name": { "type": "string" },
          "entity_type": { "enum": ["organisation", "venue", "person", "document"] },
          "required": { "type": "boolean", "default": true, "description": "false = acceptable to miss (lower weight)." }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_entity_recall", "min_verified_contacts", "evidence_required", "max_false_positive_rate"],
      "properties": {
        "min_entity_recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_verified_contacts": { "type": "integer", "minimum": 0 },
        "evidence_required": { "type": "boolean" },
        "max_false_positive_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_usd", "max_minutes"],
      "properties": {
        "max_usd": { "type": "number", "minimum": 0 },
        "max_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "gold_label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "contacts", "sources"],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_id", "canonical_name", "official_url"],
            "properties": {
              "entity_id": { "type": "string" },
              "canonical_name": { "type": "string" },
              "official_url": { "type": ["string", "null"] },
              "aliases": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_id", "value", "kind", "evidence_url"],
            "properties": {
              "entity_id": { "type": "string" },
              "value": { "type": "string", "description": "Redacted in committed fixtures; full value only in the private ground-truth store." },
              "kind": { "enum": ["email", "phone", "postal"] },
              "person": { "type": ["string", "null"] },
              "role": { "type": ["string", "null"] },
              "evidence_url": { "type": "string" }
            }
          }
        },
        "sources": {
          "type": "array",
          "description": "Authoritative sources the answer must be traceable to.",
          "items": { "type": "string" }
        }
      }
    },
    "label_status": { "enum": ["draft", "human_verified", "disputed"] },
    "verified_by": { "type": ["string", "null"] },
    "validation_timestamp": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
