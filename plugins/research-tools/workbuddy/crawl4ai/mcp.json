{
  "mcpServers": {
    "crawl4ai": {
      "type": "streamableHttp",
      "url": "https://api.crawl4ai.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CRAWL4AI_API_KEY}"
      },
      "timeout": 30000,
      "enabledTools": [
        "scrape",
        "extract"
      ]
    }
  }
}
