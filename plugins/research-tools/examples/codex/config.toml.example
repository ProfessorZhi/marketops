# Merge into the user's own ~/.codex/config.toml; do not overwrite existing MCP servers.
# Actual authentication is performed in the user's local environment, never in Git.
# Codex documentation: https://developers.openai.com/codex/config-reference

[mcp_servers.tinyfish]
url = "https://mcp.tinyfish.ai"
# Tool naming is verified at runtime; narrow to Search/Fetch until user approves paid Agent.
enabled_tools = ["search", "fetch_content"]

[mcp_servers.crawl4ai]
url = "https://api.crawl4ai.com/mcp"
bearer_token_env_var = "CRAWL4AI_API_KEY"
# Positive allowlist: anything the upstream adds later is denied until reviewed here.
enabled_tools = ["scrape", "extract"]

# Other providers:
# Serper: no confirmed official MCP. Use its API manually or MarketOps managed MCP.
# Jev: install the official TypeSafe Skill; real decisions require SDK/API or managed MCP.
