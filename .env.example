# ============================================================
# MarketOps 环境变量样例
#
# 本文件**只放变量名**，不放任何真实值，也不写任何一台机器的绝对路径。
# 真实 secret 的归属地：由部署配置指定的 secret 位置（例如部署时的凭据目录）；
# 具体路径由部署配置决定，也不写进本文件。
# 永远不要写进：Git / README / .env.example / 日志 / 测试 fixture / 聊天输出。
# ============================================================

# --- 运行目录（必填，无默认值）---
# 运行目录必须显式注入：代码内不写死任何绝对路径，否则不同运行环境
# （开发机 / 服务器）会变成两份代码。
#
# 取值形态：该环境下存放 state / logs / mirrors / benchmarks / test-data
# 的那个目录。启动时会自动创建缺的子目录。
#   * 其中的 inputs/ 装的是**调用方交进来的**东西 —— 今天只有已知账号清单
#     （submit_research 的 input_kind=known_accounts 会读 inputs/<input_ref>.yaml）。
#     它与 state/ 分开：state/ 装我们自己写出来的状态，「这个文件是谁写的」
#     在一个混在一起的目录里没有答案。清单里的内容会被当成候选池，请自己核对。
#   ⚠️ 具体路径由部署配置 / 环境变量决定，仓库不写死任何一台机器的路径，
#      也不规定数据盘下该套几层目录 —— 那是目标机器的主机档案的事。
#      部署前必须重新读取目标机器的 SSOT / 主机档案校验实际目录，
#      不能凭本文档或旧记录直接 mkdir。
MARKETOPS_DATA_ROOT=

# --- Profile ---
# 业务规则所在目录。留空则用仓库内 profiles/。
MARKETOPS_PROFILES_DIR=
MARKETOPS_PROFILE=uk-acme-natural-grass

# --- Search（Serper 只负责 URL discovery）---
SERPER_API_KEY=

# --- 决策后端（§4 / §11；两个都不配时 decide 会明确说「这次判定不会发生」）---
# Jev：托管 API 的凭据。变量名沿用厂商 SDK 自己的那一个 —— 换一个名字会让运维
# 把钥匙放进一个**我们不读**的变量里，而症状是「配了却还是 unavailable」。
# 读它的是 marketops/config.py，不是 SDK（SDK 自己的环境回退被刻意拒绝：
# 那样凭据就不在配置的视野里，也不受「凭据只在 vault 里」这条约束）。
TYPESAFE_API_KEY=
# Laya：本地权重目录。**必须是绝对路径** —— 相对路径在 Agent 眼里不是本地目录，
# 于是它会去 HuggingFace 下载一份 421M 的参数；本 adapter 不做隐式下载。
LAYA_CHECKPOINT_DIR=
# assist 模式下**唯一**被咨询的后端，取 provider 的名字（jev / laya）。
# 留空 = 本部署没有配置辅助后端。那**不是**「随便挑一个就绪的」：§4 要求辅助答案
# 进研究轨迹，所以「这条轨迹上的辅助答案来自哪里」必须是一个显式的部署决定。
MARKETOPS_DECISION_PROVIDER=

# --- MCP 服务面（只绑环回地址；名字也被拒绝）---
# 三个都没有缺省值以外的花样：地址必须是一个**字面量**环回 IP，端口有缺省。
MARKETOPS_MCP_HOST=
MARKETOPS_MCP_PORT=
# 令牌环文件的位置。留空 = 服务面照常起，但**谁都不许** —— 没有主体就没有工具可调。
# 这是配置而不是开关：自检（--check）在无环时返回非零，但服务仍然启动。
MARKETOPS_MCP_TOKENS=
# 本服务**对外自称**的资源标识符（RFC 8707）。留空 = 按上面那个绑定地址推导。
# 只有当本服务被反向代理挂在另一个公开地址后面时才需要设它 —— 那时它**不等于**
# 监听地址，而令牌的受众（mint-token --audience）必须等于这一个值。
# 写错的症状是 401，与「令牌写错」在传输层上不可区分；两边各是什么，
# ``python -m marketops.interfaces.mcp --check`` 的 mcp.resource / mcp.audiences 会说。
MARKETOPS_MCP_RESOURCE=

# --- 外部执行器（§6 的派发路径；三样缺一不可）---
# 三样**都没有缺省值**：每一项的缺省都会是「我猜你想跑的其实是……」，而这条路径上
# 猜错一次就是一次真的派发。三样一个都没给 = 本部署没有执行器（事实，不派发）；
# **只给了一两样**是一次配置事故（服务面拒绝启动，退 2），不会被当成「没配」——
# 那两句话对运维是两件事（见 interfaces/composition.py）。
# 入口脚本。不回落 PATH —— 回落会让「哪一份构建」取决于启动时的 shell。
MARKETOPS_QUAY_CLI=
# 解释器。同上。
MARKETOPS_QUAY_NODE=
# 外部工作区的根：一个含它自己 .quay/config.yml 的目录，不是「随便一个目录」。
MARKETOPS_QUAY_ROOT=
MARKETOPS_QUAY_TIMEOUT_SECONDS=

# --- 外联执行（§6；**六样缺一不可**，缺任何一样本部署就没有外发路径）---
# 这一组回答的只是「这个部署能不能构造出一条外发路径」（config.py 的
# outbound_capable）。它**不是**「可以发信了」：每一封信出门之前还要过人类授权
# （WaveAuthorization）、清单当下的状态、新鲜度、抑制、回复与时间窗。
#
# 启动自检会报「缺的是哪一样」（outbound_missing），而**不会**报口令本身。
# 这几样一个都没给 = 本部署没有外发路径（事实）；只给了一部分同样是「没有外发
# 路径」，但 outbound_missing 说得出来差哪几样 —— 照着补即可。
#
# 中继端点。**没有缺省值**：一个 127.0.0.1 的缺省会让「能不能外发」凭一个
# 没人写过的值成立。端口同理，一个缺省的 25 会让漏配与配好了给出同一个答案。
MARKETOPS_SMTP_HOST=
MARKETOPS_SMTP_PORT=
# 中继的用户名与口令。**两样必须同时给**：按网络位置认证的中继今天刻意不支持，
# 理由是那样要求的「凭据」会变成一个可以缺席的东西，而可以缺席的凭据不是一道闸
# （详见 config.py 里 outbound_missing 的 docstring）。
MARKETOPS_SMTP_USERNAME=
MARKETOPS_SMTP_PASSWORD=
# 口令**怎么出示**：starttls 或 ssl。**两样不是一个意思**，也没有 auto ——
# starttls 在明文连接上再协商 TLS（中继不支持时抛，不退回明文），ssl 从一开始
# 就连在 TLS 上。凭据与这一格是一对：只给凭据不给它，等于口令被读进来却不出示，
# 那台路径仍然是按网络位置放行。写坏的取值在装载期抛。
MARKETOPS_SMTP_SECURITY=
# 发送箱。**不是可选的装饰**：传输契约要求核对「清单上的发送箱」与「实际用的
# 发送箱」，没有它那次核对无从发生。
MARKETOPS_OUTBOUND_FROM=
# 收件人允许列表。**空 = 谁都不许**（不是谁都可以）—— 与 outbound_from 一起，
# 这两样是「这一封信能不能发给这个人」的答案。
#
# 合法条目只有两种，逗号分隔：someone@example.com 与 @example.com（后者允许该
# 域名下的任何本地部分）。**没有通配符**：`*` 不是「更多」的同义词，它说的是这份
# 名单不再是一道闸。写坏的条目在**装载期**抛（服务面拒绝启动），不是等到第一封
# 被拒的信才发现。
MARKETOPS_OUTBOUND_ALLOWLIST=

# --- 来信来源（§7；留空 = 本部署没有来信来源）---
# 一个装**来信原件**的目录：``ingest_replies`` 从那里读，游标写在
# state/reply-cursors/ 下。
# 留空 = 本部署没有这一条工具（§8「仅在部署能力启用时注册」—— 它连 tools/list
# 里都不出现，不是「点了会报尚未接线」）。这与上面那六样**不是**一组，也不进
# ``outbound_missing``：一个只能收不能发的部署是完整的一种部署，反方向亦然。
# 注意目录里装的会是**真实来信正文**：它属于 §9 点名的那一类东西（真实原始邮件），
# 所以它不得落在仓库、Git、日志或任何一处会被导出成证据的地方。
MARKETOPS_MAIL_CAPTURE_DIR=

# --- 飞书（本轮只留接口，未接线；留空不影响本地 pipeline 运行）---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# --- 运行参数（可选，留空走默认值）---
MARKETOPS_HTTP_TIMEOUT_SECONDS=
MARKETOPS_HTTP_MAX_BYTES=
MARKETOPS_BROWSER_TIMEOUT_SECONDS=
MARKETOPS_MAX_CANDIDATES_PER_ACCOUNT=

# 注意：research_only / send_authorized **不是**环境变量。
# 它们在本阶段是硬编码常量（marketops/__init__.py），模型层会拒绝
# 构造 send_authorized=True 的对象。这样「env 写错就打开了发送」不可能发生。
#
# 上面那组 MARKETOPS_SMTP_* / MARKETOPS_OUTBOUND_* **打不开它们**：外联执行是
# 一把独立的锁（config.py 模块 docstring 的「三个平面，三把各自独立的锁」）。
# 研究身份的权限集合里没有任何一个发送工具，这一条与那六个变量无关，
# 也不因为它们被填上而改变。
