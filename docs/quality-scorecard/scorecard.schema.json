{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marketops.quality.scorecard.v1",
  "_comment": "The machine-readable result of scoring one research run. Every value here is a count, a ratio, a closed-set code or an identifier — never page text, a contact value or a person's name, which is what makes the document publishable. Produced by scripts/research_quality_scorecard.py and re-derivable by scripts/research_quality_recheck.py.",
  "type": "object",
  "required": ["schema", "run_ref", "verdict", "verdict_reason", "zero_tolerance",
               "measurements", "rows", "issues", "assumptions", "inputs",
               "sanitization"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "marketops.quality.scorecard.v1"},
    "run_ref": {
      "type": "object",
      "required": ["brief_id", "generated_at", "targets_declared", "rows_submitted"],
      "additionalProperties": false,
      "properties": {
        "brief_id": {"type": ["string", "null"]},
        "generated_at": {
          "type": ["string", "null"],
          "description": "The last artefact acquisition time. Derived from the inputs, never from the clock, so scoring the same run twice gives the same document."
        },
        "targets_declared": {"type": "integer", "minimum": 0},
        "rows_submitted": {"type": "integer", "minimum": 0}
      }
    },
    "verdict": {
      "enum": ["PASS", "FAIL", "BLOCKED"],
      "description": "FAIL outranks BLOCKED: a P0 finding is a result even when other checks were unevaluable. PASS requires every check to have been evaluated and held."
    },
    "verdict_reason": {
      "type": "string",
      "description": "P0_CHECK_FAILED:<ids> | CHECK_NOT_EVALUABLE:<ids> | ALL_CHECKS_EVALUATED_AND_HELD"
    },
    "zero_tolerance": {
      "type": "object",
      "required": ["checks", "failed", "blocked", "passed"],
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "state", "subject_ref", "reason_codes"],
            "properties": {
              "id": {"type": "string", "pattern": "^AF-([0-9]|1[0-2])$"},
              "state": {"enum": ["PASS", "FAIL", "BLOCKED"]},
              "subject_ref": {"type": "string"},
              "reason_codes": {"type": "array", "items": {"type": "string"}},
              "excuse": {
                "type": "string",
                "description": "Present when state is BLOCKED. Names the artefact that was missing; a BLOCKED check prevents a PASS verdict."
              },
              "instrument": {"type": "string"}
            }
          }
        },
        "failed": {"type": "array", "items": {"type": "string"}},
        "blocked": {"type": "array", "items": {"type": "string"}},
        "passed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "measurements": {
      "type": "object",
      "description": "The ten measurements W-QA's source-quality rubric names, keyed by its ids, plus nothing else.",
      "required": ["official_domain_accuracy", "traceable_fact_ratio", "accepted_valid_rows",
                   "duplicates_per_accepted_entity", "missed_required_fields",
                   "false_positives", "manual_minutes_per_accepted_row",
                   "usd_per_accepted_row", "credits_per_accepted_row", "failure_causes"],
      "additionalProperties": false,
      "properties": {
        "official_domain_accuracy": {"$ref": "#/$defs/measurement"},
        "traceable_fact_ratio": {"$ref": "#/$defs/measurement"},
        "accepted_valid_rows": {"$ref": "#/$defs/measurement"},
        "duplicates_per_accepted_entity": {"$ref": "#/$defs/measurement"},
        "missed_required_fields": {"$ref": "#/$defs/measurement"},
        "false_positives": {"$ref": "#/$defs/measurement"},
        "manual_minutes_per_accepted_row": {"$ref": "#/$defs/measurement"},
        "usd_per_accepted_row": {"$ref": "#/$defs/measurement"},
        "credits_per_accepted_row": {"$ref": "#/$defs/measurement"},
        "failure_causes": {"$ref": "#/$defs/measurement"}
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["row_ref", "target_ref", "declared_grade", "domain_class",
                     "grade_agreement", "accepted", "traceable", "reason_codes"],
        "additionalProperties": false,
        "properties": {
          "row_ref": {"type": ["string", "null"]},
          "target_ref": {"type": ["string", "null"]},
          "declared_grade": {
            "type": ["string", "null"],
            "description": "What the producer said. Kept beside the derived class so the two can be compared rather than merged."
          },
          "domain_class": {
            "enum": ["SELF", "PARENT_BODY", "THIRD_PARTY_REFERENCE", "DIRECTORY",
                     "NO_RETRIEVED_PAGE", "CHALLENGE", "ABSENT"],
            "description": "Derived from the page the row actually cites, using the stored lineage."
          },
          "grade_agreement": {
            "enum": ["AGREE", "OVERCLAIM", "UNDERCLAIM"],
            "description": "OVERCLAIM means an evidence grade was claimed for a page that is not evidence; it blocks acceptance. UNDERCLAIM is recorded but not fatal: it is not the direction that misleads."
          },
          "accepted": {"type": "boolean"},
          "traceable": {
            "type": "boolean",
            "description": "The cited page and the excerpt are re-findable. Deliberately independent of whether the excerpt supports the field value, so a reader can tell the two failures apart."
          },
          "reason_codes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "issues": {
      "type": "array",
      "description": "One entry per P0 finding, with a stable unique id so a defect can be quoted and fixed.",
      "items": {
        "type": "object",
        "required": ["issue_id", "check", "severity", "subject_ref", "reason_codes"],
        "additionalProperties": false,
        "properties": {
          "issue_id": {"type": "string"},
          "check": {"type": "string"},
          "severity": {"const": "P0"},
          "subject_ref": {"type": "string"},
          "reason_codes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain_suffix": {
          "type": "string",
          "description": "Stated rather than implied: no public-suffix list is available offline, so the registrable-domain rule is an approximation and says so here."
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["sha256"],
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "object",
          "description": "Digest of each input file, so a reader can pin the run to the exact artefacts the scorecard was computed from.",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "sanitization": {
      "type": "object",
      "required": ["scan", "findings", "policy"],
      "additionalProperties": false,
      "properties": {
        "scan": {"enum": ["PASS", "FAIL"]},
        "findings": {"type": "array", "items": {"type": "string"}},
        "policy": {"type": "string"}
      }
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "required": ["value", "state"],
      "properties": {
        "value": {
          "type": ["string", "null"],
          "description": "A decimal string, or null. Null is 'not measurable', never zero: zero is a measurement and this is the absence of one."
        },
        "state": {
          "enum": ["MEASURED", "PARTIAL_UNKNOWN", "BLOCKED", "UNKNOWN"],
          "description": "MEASURED is the only state that is an answer. PARTIAL_UNKNOWN means part of the denominator is an unreconciled charge; BLOCKED means an input was missing."
        },
        "meter": {
          "enum": ["usd", "credits", "requests", "steps", "tokens"],
          "description": "Units are never summed across meters."
        },
        "excuse": {"type": "string"},
        "unknown_exposure_usd": {
          "type": "string",
          "description": "The unreconciled part, kept out of `value` so a confirmed figure is never read as an all-in one."
        },
        "all_in_usd": {
          "type": "string",
          "description": "Confirmed plus unreconciled, reported separately and never as `value`."
        },
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer"},
        "total": {"type": "integer"},
        "count": {"type": "integer"},
        "rows": {"type": "array", "items": {"type": "string"}},
        "total_minutes": {"type": "string"},
        "by_field": {"type": "object"},
        "by_state": {"type": "object"},
        "by_reason_code": {"type": "object"}
      }
    }
  }
}
