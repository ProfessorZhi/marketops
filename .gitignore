# ============================================================
# MarketOps .gitignore
# 原则：源码 / 文档 / 契约 / profiles / tests 进 repo；
#       一切运行数据、secret、第三方源码、浏览器二进制 一律不进。
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- 虚拟环境与工具缓存 ---
.venv/
venv/
env/
ENV/
.python-version
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# --- Secrets：真实凭据永不入 repo ---
# 本机真实 secret 归属 %LOCALAPPDATA%\FengjiangKnowledge\marketops\
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# --- MarketOps 运行数据：位置由部署配置给出（MARKETOPS_DATA_ROOT），不写死 ---
/data/
/state/
/logs/
/mirrors/
/benchmarks/
/test-data/
/test-output/
/artifacts/
*.log

# --- 第三方源码：各自独立 git repo，不复制、不作 submodule ---
/crawl4ai/
/MinerU/
/vendor/
third_party/

# --- Playwright 浏览器二进制与下载缓存 ---
/ms-playwright/
.playwright/
/browsers/
node_modules/

# --- 编辑器 / 操作系统 ---
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
