# 强制 LF 入库：Windows 开发、Linux 部署时不产生行尾漂移。
# 这是 Windows → Linux 可迁移性的一部分，不要改成 eol=crlf。
* text=auto eol=lf

# 二进制资产不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.woff binary
*.woff2 binary
*.xlsx binary
*.docx binary

# Shell 脚本必须 LF，否则 Linux 上会报 bad interpreter
*.sh text eol=lf
*.bash text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
